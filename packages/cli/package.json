{
  "name": "@tcpioneer/cli",
  "version": "0.0.1",
  "description": "CLI wrapper for TCPIOneer",
  "license": "MIT",
  "author": "Byte-ByByte",
  "type": "commonjs",
  "main": "./dist/main.js",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.mjs",
      "require": "./dist/main.js"
    }
  },
  "scripts": {
    "test": "npm run build",
    "start": "node dist/main.js",
    "build": "npx tsup && tsc"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "builtin-modules": "^5.4.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tcpioneer/core": "*"
  }
}
